# Canonical site URL (www.iterralabs.com — .com.au redirects here)
NEXT_PUBLIC_SITE_URL=https://www.iterralabs.com

# ── Resend (email delivery) ──
# Get an API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Must be an address on a domain you've verified in Resend
# (Resend → Domains → Add Domain → add DNS records)
CONTACT_FROM_EMAIL=contact@yourdomain.com

# Where contact-form submissions are delivered
CONTACT_TO_EMAIL=hello@yourdomain.com

# ── Google reCAPTCHA v3 ──
# Create keys at https://www.google.com/recaptcha/admin/create
# Type: reCAPTCHA v3 | add your domain + localhost
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6Lxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RECAPTCHA_SECRET_KEY=6Lxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
